# Copy to .env.local for local work. On Railway, set these as service variables.
# Nothing here is required to run the site; unset values fall back as described.

# Public origin used for canonical URLs, the sitemap, robots.txt and OG/Twitter image URLs.
# Read at build time. Default: https://decignal.up.railway.app
NEXT_PUBLIC_SITE_URL=

# Audit form delivery (app/api/audit). Set either channel, or both.
# With neither, the API answers 503 and the form offers the downloadable brief instead: nobody receives
# the request. Delivered requests include `source`, the page path the form was sent from.
# 1) Webhook: receives a JSON POST per request (Slack incoming webhook, Make, Zapier, n8n, a CRM hook).
#    Google Sheet: deploy scripts/audit-sheet.gs as a web app and set <exec URL>?key=<its SECRET> here.
AUDIT_WEBHOOK_URL=
# 2) Email through Resend: all three are needed. AUDIT_TO_EMAIL may be a comma separated list.
RESEND_API_KEY=
AUDIT_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. Decignal <audit@yourdomain>
AUDIT_FROM_EMAIL=

# Public contact address. The footer, error page, privacy notice and the audit form's email fallback
# appear only when this is set. Set it before launch (README, Owner review).
NEXT_PUBLIC_CONTACT_EMAIL=
